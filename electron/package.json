{
  "name": "spring-ai-playground",
  "version": "0.0.0-dev",
  "description": "Desktop launcher for the Spring AI Community incubating project Spring AI Playground",
  "homepage": "https://github.com/spring-ai-community/spring-ai-playground",
  "author": {
    "name": "Jemin Huh",
    "email": "hjm1980@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "prepare:resources:native": "node scripts/prepare-resources.mjs",
    "dist": "electron-builder --publish never",
    "dist:mac:dir": "electron-builder --mac dir --publish never",
    "dist:mac:dmg": "electron-builder --mac dmg --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:linux": "electron-builder --linux deb rpm --publish never",
    "dist:linux:deb": "electron-builder --linux deb --publish never",
    "dist:linux:rpm": "electron-builder --linux rpm --publish never"
  },
  "build": {
    "appId": "com.springai.playground",
    "productName": "Spring AI Playground",
    "publish": {
      "provider": "github",
      "owner": "spring-ai-community",
      "repo": "spring-ai-playground"
    },
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "*.js",
      "*.html",
      "static/**/*",
      "resources/**/*",
      "!resources/app.jar",
      "!resources/jre-bundle{,/**}",
      "!resources/default-application.yaml",
      "!resources/catalog{,/**}"
    ],
    "extraResources": [
      {
        "from": "resources/app.jar",
        "to": "app.jar"
      },
      {
        "from": "resources/jre-bundle",
        "to": "jre-bundle"
      },
      {
        "from": "resources/default-application.yaml",
        "to": "default-application.yaml"
      },
      {
        "from": "resources/catalog",
        "to": "catalog"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "spring-ai-playground-${version}-win-${arch}.${ext}",
      "icon": "static/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spring AI Playground",
      "installerIcon": "static/icons/icon.ico",
      "uninstallerIcon": "static/icons/icon.ico",
      "installerHeaderIcon": "static/icons/icon.ico",
      "deleteAppDataOnUninstall": true
    },
    "mac": {
      "target": "dmg",
      "artifactName": "spring-ai-playground-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "icon": "static/icons/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "-",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "This app needs access to your microphone for voice input."
      }
    },
    "dmg": {
      "title": "Spring AI Playground",
      "icon": "static/icons/icon.icns",
      "iconSize": 128,
      "window": {
        "width": 560,
        "height": 360
      },
      "contents": [
        {
          "x": 160,
          "y": 170,
          "type": "file"
        },
        {
          "x": 400,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "artifactName": "spring-ai-playground-${version}-linux-${arch}.${ext}",
      "executableName": "spring-ai-playground",
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "Jemin Huh <hjm1980@gmail.com>",
      "icon": "static/icons/icon.png",
      "synopsis": "Desktop launcher for Spring AI Playground",
      "description": "Spring AI Playground, an incubating Spring AI Community project, packaged as an Electron desktop application with an OS-native backend."
    }
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@kutalia/whisper-node-addon": "^1.1.0",
    "ace-builds": "^1.44.0",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.2.0",
    "ollama": "^0.6.3",
    "tree-kill": "^1.2.2"
  }
}
