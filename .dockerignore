# Don't ship build / VCS / IDE / docs into the build context.
# Keeps `docker build` fast and the build cache stable.

.git
.gitignore
.gitattributes
.github

.claude
.idea
.vscode
.editorconfig

# Maven build output and dependency cache (rebuilt inside the builder stage),
# but let the fat JAR through so the CI `build-jar` job can drop a pre-built
# artifact into target/ and the Dockerfile can skip the in-image mvn step.
target
!target/spring-ai-playground-*.jar
target/spring-ai-playground-*.jar.original
.mvn/wrapper/maven-wrapper.jar

# Vaadin / Node frontend caches (regenerated by -Pproduction)
node_modules
package-lock.json
.npm
.pnp
frontend/generated
src/main/bundles

# Documentation & assets that don't need to be in the runtime
docs
README.md
*.md
LICENSE*
mkdocs.yml

# Plan / scratchpads / logs
plans
*.log

# Desktop launcher / Electron sources (separate distribution path)
desktop
electron
launcher
release-assets

# OS / editor artifacts
.DS_Store
Thumbs.db
